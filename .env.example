# Salin ke .env.local lalu sesuaikan. Restart dev server setelah mengubah.
# Default mengarah ke API lokal (local-api/). Jangan isi URL produksi di repo ini.

# Rewrite /backend/* (next.config.ts). Dibaca saat `next dev` / `next build` (build arg di Docker).
API_URL=http://localhost:8080/api/v1/:path*

# Route /api/* dan /api/proxy/* (server-to-server). Tanpa "/" di akhir.
API_INTERNAL_URL=http://localhost:8080

# Dipakai juga di browser (banner halaman login). Ikut ter-build.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Cloudflare Turnstile site key (publik). "off" = tanpa captcha (API lokal tidak memeriksanya).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=off
