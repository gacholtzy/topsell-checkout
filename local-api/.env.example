# Salin ke .env lalu isi. File .env tidak masuk repo.

# Postgres (mis. Neon). Tabel dibuat otomatis saat server start.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# Biteship (key testing "biteship_test..." cukup). Kosong = alamat & ongkir pakai data contoh.
BITESHIP_API_KEY=

# Gudang asal & data pengirim untuk ongkir dan pemesanan kurir Biteship.
BITESHIP_ORIGIN_POSTAL_CODE=61219
BITESHIP_COURIERS=jne,jnt,sicepat,anteraja
SHIPPER_NAME=Topsell Belanja
SHIPPER_PHONE=081234567890
SHIPPER_EMAIL=toko@topsell.test
ORIGIN_ADDRESS=Jl. Ahmad Yani No. 1, Sidoarjo

